# SkillRock Ambassador Portal Backend Environment Variables Template
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ssap_campus_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@skillrock.in
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password
FRONTEND_URL=http://localhost:5174
MAIN_SKILLROCK_URL=https://skillrock.onrender.com
DEFAULT_COMMISSION_PERCENT=20
